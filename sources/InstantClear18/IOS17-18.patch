--- a/Compatibility.h
+++ b/Compatibility.h
@@ -0,0 +1,8 @@
+#pragma once
+#import <Foundation/Foundation.h>
+
+// Keep future major versions opt-in; all 17.x and 18.x point releases qualify.
+static inline BOOL BTSupportsIOS17And18(void) {
+    NSInteger major = NSProcessInfo.processInfo.operatingSystemVersion.majorVersion;
+    return major == 17 || major == 18;
+}
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
 ARCHS = arm64 arm64e
-TARGET = iphone:clang:latest:15.0
+TARGET = iphone:clang:16.5:17.0
 THEOS_PACKAGE_SCHEME = rootless
 FINALPACKAGE = 1
 DEBUG = 0
--- a/Tweak.m
+++ b/Tweak.m
@@ -1,3 +1,4 @@
+#import "Compatibility.h"
 #import <Foundation/Foundation.h>
 #import <objc/message.h>
 #import <objc/runtime.h>
@@ -58,7 +59,7 @@
 }
 __attribute__((constructor)) static void Initialize(void) {
     @autoreleasepool {
-        if (NSProcessInfo.processInfo.operatingSystemVersion.majorVersion != 18) return;
+        if (!BTSupportsIOS17And18()) return;
         dispatch_async(dispatch_get_main_queue(), ^{ Install(); });
     }
 }
