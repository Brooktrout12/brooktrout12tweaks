+static bool BTPrepareVolume(void) {
+    int percent = BTReadVolume();
+    NSMutableData *scaled = [BTOriginalAudio mutableCopy];
+    if (!scaled || !BTScaleCAF(scaled.mutableBytes, scaled.length, (unsigned int)percent)) {
+        [scaled release];
