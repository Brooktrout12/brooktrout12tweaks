+@interface BTLockVolumeCell : PSTableCell
+@property(nonatomic, strong) UISlider *volumeSlider;
+@property(nonatomic, strong) UILabel *percentageLabel;
+@property(nonatomic) int lastSavedPercent;
+@end
+
+@implementation BTLockVolumeCell
+- (instancetype)initWithStyle:(UITableViewCellStyle)style reuseIdentifier:(NSString *)identifier
+                    specifier:(PSSpecifier *)specifier {
+    self = [super initWithStyle:style reuseIdentifier:identifier specifier:specifier];
+    if (!self) return nil;
+    self.selectionStyle = UITableViewCellSelectionStyleNone;
+    self.textLabel.text = nil;
+    UILabel *title = [UILabel new];
+    title.text = @"Lock sound volume";
+    title.font = [UIFont preferredFontForTextStyle:UIFontTextStyleBody];
+    title.adjustsFontForContentSizeCategory = YES;
+    title.adjustsFontSizeToFitWidth = YES;
+    title.minimumScaleFactor = 0.7;
+    self.percentageLabel = [UILabel new];
+    self.percentageLabel.font = [[UIFontMetrics metricsForTextStyle:UIFontTextStyleBody]
+        scaledFontForFont:[UIFont monospacedDigitSystemFontOfSize:17 weight:UIFontWeightSemibold]];
+    self.percentageLabel.adjustsFontForContentSizeCategory = YES;
+    self.percentageLabel.textAlignment = NSTextAlignmentRight;
+    [self.percentageLabel setContentCompressionResistancePriority:UILayoutPriorityRequired
+        forAxis:UILayoutConstraintAxisHorizontal];
+    self.volumeSlider = [UISlider new];
+    self.volumeSlider.minimumValue = 0;
+    self.volumeSlider.maximumValue = 100;
+    self.volumeSlider.continuous = YES;
+    self.volumeSlider.minimumValueImage = [UIImage systemImageNamed:@"speaker.slash.fill"];
+    self.volumeSlider.maximumValueImage = [UIImage systemImageNamed:@"speaker.wave.3.fill"];
+    self.volumeSlider.accessibilityLabel = @"Lock sound volume";
+    [self.volumeSlider addTarget:self action:@selector(volumeChanged:)
+        forControlEvents:UIControlEventValueChanged];
+    [self.volumeSlider addTarget:self action:@selector(commitVolume:)
+        forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel];
+    for (UIView *view in @[title, self.percentageLabel, self.volumeSlider]) {
+        view.translatesAutoresizingMaskIntoConstraints = NO;
+        [self.contentView addSubview:view];
+    }
+    UILayoutGuide *margins = self.contentView.layoutMarginsGuide;
+    [NSLayoutConstraint activateConstraints:@[
+        [title.leadingAnchor constraintEqualToAnchor:margins.leadingAnchor],
+        [title.topAnchor constraintEqualToAnchor:self.contentView.topAnchor constant:14],
+        [title.trailingAnchor constraintLessThanOrEqualToAnchor:self.percentageLabel.leadingAnchor constant:-12],
+        [self.percentageLabel.trailingAnchor constraintEqualToAnchor:margins.trailingAnchor],
+        [self.percentageLabel.firstBaselineAnchor constraintEqualToAnchor:title.firstBaselineAnchor],
+        [self.volumeSlider.leadingAnchor constraintEqualToAnchor:margins.leadingAnchor],
+        [self.volumeSlider.trailingAnchor constraintEqualToAnchor:margins.trailingAnchor],
+        [self.volumeSlider.topAnchor constraintEqualToAnchor:title.bottomAnchor constant:8],
+        [self.volumeSlider.heightAnchor constraintEqualToConstant:36]
+    ]];
+    self.lastSavedPercent = BTReadVolume();
+    self.volumeSlider.value = self.lastSavedPercent;
+    [self updatePercentage];
+    return self;
+}
+- (void)updatePercentage {
+    int percent = BTVolumePercent(self.volumeSlider.value);
+    NSString *text = [NSString stringWithFormat:@"%d%%", percent];
+    self.percentageLabel.text = text;
+    self.volumeSlider.accessibilityValue = text;
+}
+- (void)volumeChanged:(UISlider *)slider {
+    [self updatePercentage];
+    /* Touch drags update the label immediately and save once on release.
+       VoiceOver, Switch Control and keyboard changes save immediately. */
+    if (!slider.isTracking) [self commitVolume:slider];
+}
+- (void)commitVolume:(UISlider *)slider {
+    int percent = BTVolumePercent(slider.value);
+    slider.value = percent;
+    [self updatePercentage];
+    if (percent != self.lastSavedPercent) {
+        BTWriteVolume(percent);
+        self.lastSavedPercent = percent;
+    }
+}
+- (void)refreshCellContentsWithSpecifier:(PSSpecifier *)specifier {
+    [super refreshCellContentsWithSpecifier:specifier];
+    self.textLabel.text = nil;
+    if (self.volumeSlider && !self.volumeSlider.isTracking) {
+        self.lastSavedPercent = BTReadVolume();
+        self.volumeSlider.value = self.lastSavedPercent;
+        [self updatePercentage];
+    }
+}
+@end
+
+@interface BTLockSoundPrefsController : PSListController
+@end
+@implementation BTLockSoundPrefsController
+- (NSMutableArray *)specifiers {
+    if (!_specifiers) {
+        self.title = @"Classic Lock Sound";
+        NSMutableArray *items = [NSMutableArray array];
+        PSSpecifier *group = [PSSpecifier groupSpecifierWithName:@"Volume"];
+        [group setProperty:@"0% is silent. 100% uses the original recording at full level. Your iPhone’s ringer volume and Silent Mode still apply. Changes take effect on the next lock." forKey:@"footerText"];
+        [items addObject:group];
+        PSSpecifier *slider = [PSSpecifier preferenceSpecifierNamed:@"Lock sound volume" target:self
+            set:NULL get:NULL detail:Nil cell:PSStaticTextCell edit:Nil];
+        slider.identifier = @"LockVolume";
+        [slider setProperty:BTLockVolumeCell.class forKey:@"cellClass"];
+        [slider setProperty:@100 forKey:@"height"];
+        [items addObject:slider];
+        PSSpecifier *reset = [PSSpecifier preferenceSpecifierNamed:@"Reset to 100%" target:self
+            set:NULL get:NULL detail:Nil cell:PSButtonCell edit:Nil];
+        reset.buttonAction = @selector(resetVolume);
+        [items addObject:reset];
+        PSSpecifier *about = [PSSpecifier emptyGroupSpecifier];
+        [about setProperty:@"Classic Lock Sound 1.0.7 · Brooktrout12\niOS 17–18 · Rootless" forKey:@"footerText"];
+        [items addObject:about];
+        _specifiers = items;
+    }
+    return _specifiers;
+}
+- (void)viewWillAppear:(BOOL)animated {
+    [super viewWillAppear:animated];
+    [self reloadSpecifiers];
+}
+- (CGFloat)tableView:(UITableView *)tableView heightForRowAtIndexPath:(NSIndexPath *)indexPath {
+    if ([[self specifierAtIndexPath:indexPath].identifier isEqualToString:@"LockVolume"])
+        return MAX(100, [UIFont preferredFontForTextStyle:UIFontTextStyleBody].lineHeight + 72);
+    return [super tableView:tableView heightForRowAtIndexPath:indexPath];
+}
+- (void)resetVolume {
+    BTWriteVolume(100);
+    [self reloadSpecifiers];
+}
+@end
